# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Required, no default in code. Must be a model id your key can use (verified at startup check).
LLM_MODEL=
# Optional
DB_PATH=data/cache.sqlite
ALERT_WEBHOOK_URL=
ALERT_SCHEDULE_HOURS=6
NWS_USER_AGENT=weather-risk-agent (demo)
# Optional LLM tuning
LLM_EFFORT=medium
# Server-side refusal fallback (beta). "off" to disable.
LLM_FALLBACKS=default
# Alerts: minimum score move (points) that triggers an alert; level changes always do
ALERT_SCORE_DELTA=5
# Optional alternative scoring config (what-if weights); default config/scoring.yaml
SCORING_CONFIG=
# Public deploy protection (leave empty locally): required X-Access-Code on /chat, /refresh, /alerts/check
ACCESS_CODE=
# /chat rate limit per client IP (requests per window); 0 disables
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_S=600
