# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Required, no default in code. Must be a model id your key can use (verified at startup check).
LLM_MODEL=
# Optional
DB_PATH=data/cache.sqlite
ALERT_WEBHOOK_URL=
# In-process scheduler (opt-in fallback for always-on hosts; 0 = off). Render uses GitHub Actions instead.
ALERT_SCHEDULE_HOURS=0
NWS_USER_AGENT=weather-risk-agent (demo)
# Optional LLM tuning
LLM_EFFORT=medium
# Server-side refusal fallback (beta). "off" to disable.
LLM_FALLBACKS=default
# Alerts: minimum score move (points) that triggers an alert; level changes always do
ALERT_SCORE_DELTA=5
# Optional alternative scoring config (what-if weights); default config/scoring.yaml
SCORING_CONFIG=
# Public deploy protection (leave empty locally): required X-Access-Code on /chat, /refresh, /alerts/check
ACCESS_CODE=
# /chat rate limit per client IP (requests per window); 0 disables
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_S=600
# Durable state (score snapshots, alert log, chat memory). Empty = local SQLite. Production: Neon Postgres URL.
DATABASE_URL=
# Alert check refuses (409) if the data cache wasn't refreshed within this many hours
ALERT_MAX_DATA_AGE_H=12
# auto | json | slack  (auto = Slack text for hooks.slack.com URLs)
ALERT_WEBHOOK_FORMAT=auto
# Rolling window: pin the last full year (tests/reproducibility); roll day in January (default 15)
ANALYSIS_END_YEAR=
WINDOW_ROLL_DAY=15
# Pause between hubs during a refresh (seconds), to be polite to the free APIs
REFRESH_PAUSE_S=1.0
